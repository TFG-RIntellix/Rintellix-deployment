    {
      "name": "Predict Loan (Préstamos)",
      "item": [
        {
          "name": "✅ Predict Loan - Perfil bajo riesgo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has PD and risk_segment', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('probability_of_default');",
                  "    pm.expect(json.probability_of_default).to.be.a('number');",
                  "    pm.expect(json.probability_of_default).to.be.at.least(0);",
                  "    pm.expect(json.probability_of_default).to.be.at.most(1);",
                  "    pm.expect(json).to.have.property('risk_segment');",
                  "    pm.expect(json.risk_segment).to.be.oneOf(['Low', 'Medium', 'High']);",
                  "});",
                  "pm.test('Response has SHAP explanations', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('shap_explanations');",
                  "    pm.expect(json.shap_explanations).to.be.an('array');",
                  "    pm.expect(json.shap_explanations.length).to.be.greaterThan(0);",
                  "    var firstExpl = json.shap_explanations[0];",
                  "    pm.expect(firstExpl).to.have.property('feature');",
                  "    pm.expect(firstExpl).to.have.property('impact');",
                  "    pm.expect(firstExpl).to.have.property('direction');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
