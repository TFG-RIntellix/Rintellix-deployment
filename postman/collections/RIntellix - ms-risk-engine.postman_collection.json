      "name": "Simulation Draft (Préstamo)",
      "item": [
        {
          "name": "✅ Calcular Draft - Préstamo - Éxito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has simulatedResults', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('simulatedResults');",
                  "    pm.expect(json.simulatedResults).to.have.property('pd');",
                  "    pm.expect(json.simulatedResults).to.have.property('lgd');",
                  "    pm.expect(json.simulatedResults).to.have.property('ead');",
                  "    pm.expect(json.simulatedResults).to.have.property('ecl');",
                  "    pm.expect(json.simulatedResults).to.have.property('riskGrade');",
                  "    pm.expect(json.simulatedResults).to.have.property('decision');",
                  "});",
                  "pm.test('Response has deltas', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('deltas');",
                  "});",
                  "pm.test('Response has metrics', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('metrics');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
