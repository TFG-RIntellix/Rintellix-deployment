      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "// Pre-request script global: no hace nada por defecto.",
          "// Las requests individuales manejan su propia autenticación."
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "TOKEN_ENDPOINT",
      "value": "{{KEYCLOAK_BASE_URL}}/realms/{{KEYCLOAK_REALM}}/protocol/openid-connect/token"
    }
  ]
}